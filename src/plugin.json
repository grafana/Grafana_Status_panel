{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/master/docs/sources/developers/plugins/plugin.schema.json",
  "type": "panel",
  "name": "Status Panel",
  "id": "vonage-status-panel",
  "info": {
    "description": "Show the status of an environment at a glance: one card per piece of equipment, coloured by the worst of its metrics.",
    "author": {
      "name": "Grafana",
      "url": "https://github.com/grafana/Grafana_Status_panel"
    },
    "keywords": ["status", "panel", "state", "monitoring", "dashboard", "card"],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Github",
        "url": "https://github.com/grafana/Grafana_Status_panel"
      },
      {
        "name": "License",
        "url": "https://github.com/grafana/Grafana_Status_panel/blob/master/LICENSE"
      }
    ],
    "screenshots": [
      {
        "name": "Environment overview",
        "path": "img/environment_snapshot.png"
      },
      {
        "name": "Network switch (ports up and down)",
        "path": "img/switch.png"
      },
      {
        "name": "OK state",
        "path": "img/ok.png"
      },
      {
        "name": "Warning state",
        "path": "img/warning.png"
      },
      {
        "name": "Critical state",
        "path": "img/error.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=10.4.0-0",
    "plugins": []
  }
}
